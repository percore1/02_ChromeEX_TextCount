{
  "manifest_version": 3,
  "name": "TextCount",
  "version": "1.0",
  "description": "Webページの選択範囲の文字数を指定ルールでカウントします",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TextCount"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
